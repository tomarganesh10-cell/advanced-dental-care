# Reverse proxy and TLS for the clinic platform.
#
# Caddy obtains and renews a Let's Encrypt certificate on its own, which is the
# whole reason it is here rather than nginx + certbot: one less cron job that
# can silently stop renewing.
#
# SITE_DOMAIN and ADMIN_EMAIL come from the environment (see .env).

{
	email {$ADMIN_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# The application sets its own CSP, HSTS and frame headers per request —
	# see src/middleware.ts. Nothing is added here that would conflict.
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 10
		}
	}
}

# Redirect the www host to the apex, so the site has one canonical origin.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# =============================================================================
# Advanced Dental Care Centre — environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit a populated .env file.
# Every variable here is validated at boot by src/lib/env.ts — the app refuses
# to start in production if a required secret is missing or obviously a
# placeholder.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Public origin of the site. Used for canonical URLs, sitemap, OAuth callbacks
# and signed-URL generation. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# PostgreSQL 16+. Special characters in the password MUST be percent-encoded.
DATABASE_URL=postgresql://adcc:change-me@localhost:5432/adcc?schema=public
# Separate database used by `npm run test:integration`. It is TRUNCATED between
# test files, so never point this at anything real.
TEST_DATABASE_URL=postgresql://adcc:change-me@localhost:5432/adcc_test?schema=public

# --- Redis ------------------------------------------------------------------
# Used for rate limiting, OTP throttling, session revocation and the job queue.
# If unset the app falls back to an in-process limiter (single instance only).
REDIS_URL=redis://localhost:6379

# --- Authentication ---------------------------------------------------------
# 32+ random bytes, base64. Generate with:  openssl rand -base64 48
AUTH_SECRET=replace-with-openssl-rand-base64-48
# Staff session lifetime (seconds). Default 8h — one clinic shift.
AUTH_STAFF_SESSION_TTL=28800
# Patient portal session lifetime (seconds). Default 7 days.
AUTH_PATIENT_SESSION_TTL=604800
# Set to "true" to require TOTP for every staff account (recommended in prod).
AUTH_REQUIRE_STAFF_MFA=false

# --- OTP --------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Development only: when true, generated OTPs are written to the server log
# instead of being sent. Has no effect when NODE_ENV=production.
OTP_DEV_ECHO=true

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# Provider is pluggable: "meta" | "console" | "disabled".
# "console" logs the message instead of sending — use it until templates are
# approved by Meta.
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Shared secret used to verify inbound delivery-status webhooks from Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Email ------------------------------------------------------------------
# "resend" | "smtp" | "console" | "disabled"
EMAIL_PROVIDER=console
EMAIL_FROM="Advanced Dental Care Centre <noreply@chandigarhdentist.com>"
EMAIL_PROVIDER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- SMS (optional fallback) ------------------------------------------------
# "msg91" | "console" | "disabled"
SMS_PROVIDER=console
SMS_PROVIDER_KEY=
SMS_SENDER_ID=

# --- Payments (Razorpay) ----------------------------------------------------
# Key ID is safe to expose to the browser; the secret and webhook secret are
# server-only and must never appear in client bundles.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Consultation booking fee in paise (INR). 0 disables pay-to-book.
CONSULTATION_FEE_PAISE=0

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) -----------
# Holds X-rays, CBCT scans, clinical photos, prescriptions and invoices.
# The bucket MUST be private — files are served only via short-lived signed URLs.
STORAGE_ENDPOINT=
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=adcc-patient-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
# Signed download URL lifetime (seconds). Keep this short.
STORAGE_SIGNED_URL_TTL=300

# --- Google -----------------------------------------------------------------
# Maps embed + directions.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Places API key used to fetch the live Google rating/review count. If unset,
# the site shows no rating at all rather than a stale hardcoded number.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# How long to cache the Places response (seconds). 6h is a good default.
GOOGLE_PLACES_CACHE_TTL=21600

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
GOOGLE_SITE_VERIFICATION=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
# Optional: error reporting DSN.
SENTRY_DSN=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_BOOKING_PER_HOUR=10
RATE_LIMIT_OTP_PER_HOUR=8
RATE_LIMIT_LOGIN_PER_15MIN=10

# --- Seeding ----------------------------------------------------------------
# Password for the demo SUPER_ADMIN created by `npm run db:seed`.
# Seed refuses to run against NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!Dev123
